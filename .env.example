# API Keys - Replace with your actual values
HERE_API_KEY=your_here_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# HERE API Credentials - Replace with your actual values
HERE_USER_ID=your_here_user_id_here
HERE_CLIENT_ID=your_here_client_id_here
HERE_ACCESS_KEY_ID=your_here_access_key_id_here
HERE_ACCESS_KEY_SECRET=your_here_access_key_secret_here
HERE_TOKEN_ENDPOINT_URL=https://account.api.here.com/oauth2/token

# Android Signing - Replace with your actual values
ANDROID_STORE_PASSWORD=your_store_password_here
ANDROID_KEY_PASSWORD=your_key_password_here
ANDROID_KEY_ALIAS=your_key_alias_here
ANDROID_STORE_FILE=path_to_your_keystore_file