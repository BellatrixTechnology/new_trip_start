# HERE API Credentials - Replace with your actual values
here.user.id = your_here_user_id_here
here.client.id = your_here_client_id_here
here.access.key.id = your_here_access_key_id_here
here.access.key.secret = your_here_access_key_secret_here
here.token.endpoint.url = https://account.api.here.com/oauth2/token
here.api.key = your_here_api_key_here